<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Tsundoku.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:markup="clr-namespace:Tsundoku.MarkupExtensions"
    xmlns:pages="clr-namespace:Tsundoku.Pages"
    Title="{markup:Translate Key=AppTitle}">

    <ShellContent
        Title="{markup:Translate Key=NavLibrary}"
        ContentTemplate="{DataTemplate pages:LibraryPage}"
        Route="Library" />

</Shell>
