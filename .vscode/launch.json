{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run (Mac Catalyst, no debug)",
            "type": "coreclr",
            "request": "launch",
            "noDebug": true,
            "preLaunchTask": "maccatalyst: build",
            "program": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Tsundoku/Tsundoku.csproj",
                "-f",
                "net10.0-maccatalyst",
                "-c",
                "Debug",
                "-t:Run"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Run (iOS Simulator, no debug)",
            "type": "coreclr",
            "request": "launch",
            "noDebug": true,
            "preLaunchTask": "ios-sim: boot",
            "program": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Tsundoku/Tsundoku.csproj",
                "-f",
                "net10.0-ios",
                "-c",
                "Debug",
                "-t:Build",
                "-t:Run",
                "-p:RuntimeIdentifier=iossimulator-arm64"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Debug (Mac Catalyst - run then attach)",
            "type": "coreclr",
            "request": "attach",
            "preLaunchTask": "maccatalyst: run",
            "processId": "${command:pickProcess}",
            "justMyCode": true
        },
        {
            "name": "Debug (iOS Simulator - run then attach)",
            "type": "coreclr",
            "request": "attach",
            "preLaunchTask": "ios-sim: run",
            "processId": "${command:pickProcess}",
            "justMyCode": true
        },
        {
            "name": "Attach (pick process)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": true
        }
    ]
}